{
  "name": "certification-mcp-servers",
  "version": "1.0.0",
  "description": "MCP servers for automated certification study guide creation",
  "type": "module",
  "scripts": {
    "start:research": "node certification-research-mcp.js",
    "start:question-gen": "node question-generator-mcp.js",
    "start:quiz-engine": "node quiz-engine-mcp.js",
    "install-all": "npm install",
    "setup": "npm run install-all && npm run create-dirs",
    "create-dirs": "mkdir -p certification-research question-banks quiz-data analytics"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "fs-extra": "^11.0.0",
    "lodash": "^4.17.21",
    "uuid": "^9.0.0",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "mcp",
    "certification",
    "education",
    "questions",
    "study-guide"
  ],
  "author": "Certification Study Guide Creator",
  "license": "MIT"
}